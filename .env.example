# ============================================
# Copy this file to ".env" and fill values
# ============================================

# Bot ka naam
BOT_NAME=VORTEX-MD

# Tumhara naam (owner)
BOT_OWNER=Vortex

# Tumhara WhatsApp number (country code + number, + sign nahi)
# Example Pakistan: 923001234567
OWNER_NUMBER=923478351899

# Jis number pe bot chalana hai (pairing ke liye)
PHONE_NUMBER=923478351899

# Command prefix (default .)
PREFIX=.

# Gemini AI free key - yahan se lo: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_key_here

# Gemini model (free best: gemini-2.5-flash)
GEMINI_MODEL=AQ.Ab8RN6Lfaf0GoF9kx8epLMBbNnF8DpzHmk3HkqAPR7wH5B5S7g

# Server port (hosting pe auto mil jata hai)
PORT=3000
